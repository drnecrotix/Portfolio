generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum PostType {
  ARTICLE
  POETRY
  THOUGHT
  NOTE
  PROJECT_LOG
}

enum SiteMode {
  NORMAL
  MAINTENANCE
  COMING_SOON
  PRIVATE
  ARCHIVE
}

enum StoreProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StoreOrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  revisions    Revision[]
}

model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  description     String
  longDescription String?       @db.Text
  status          ProjectStatus @default(PLANNED)
  category        String?
  technologies    String[]
  tools           String[]
  highlights      String[]
  repoUrl         String?
  demoUrl         String?
  role             String?
  timeline        String?
  team            String?
  sortOrder       Int           @default(0)
  content         Json?
  seoTitle        String?
  seoDescription String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  revisions       Revision[]
}

model Post {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  excerpt        String?
  content        Json
  type           PostType          @default(ARTICLE)
  postTypeId     String?
  postType       BlogPostType?     @relation(fields: [postTypeId], references: [id], onDelete: SetNull)
  status         ContentStatus     @default(DRAFT)
  category       String?
  categoryId     String?
  categoryRef    BlogCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           String[]
  authorName     String
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  scheduledAt    DateTime?
  viewCount      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  revisions      Revision[]
  comments       BlogComment[]
  likes          BlogPostLike[]

  @@index([postTypeId])
  @@index([categoryId])
}

model BlogComment {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     BlogComment[] @relation("BlogCommentReplies")
  authorName  String
  authorEmail String?
  content     String        @db.Text
  status      String        @default("APPROVED")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([postId, status, createdAt])
  @@index([parentId, createdAt])
}

model BlogPostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
  @@index([postId, createdAt])
}

model BlogPostType {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  editorMode  PostType @default(ARTICLE)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  status         ContentStatus @default(DRAFT)
  content         Json
  seoTitle        String?
  seoDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  revisions       Revision[]
}

model NavigationItem {
  id            String           @id @default(cuid())
  label         String
  href          String
  location      String           @default("primary")
  sortOrder     Int              @default(0)
  isVisible     Boolean          @default(true)
  isExternal    Boolean          @default(false)
  isDropdown    Boolean          @default(false)
  dropdownStyle String           @default("auto")
  parentId      String?
  parent        NavigationItem?  @relation("NavigationChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      NavigationItem[] @relation("NavigationChildren")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([parentId, sortOrder])
}

model GalleryWorkStats {
  slug      String            @id
  viewCount Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  likes     GalleryWorkLike[]
}

model GalleryWorkLike {
  id        String           @id @default(cuid())
  slug      String
  stats     GalleryWorkStats @relation(fields: [slug], references: [slug], onDelete: Cascade)
  visitorId String
  createdAt DateTime         @default(now())

  @@unique([slug, visitorId])
  @@index([slug, createdAt])
}

model ExperimentMetric {
  experimentId String
  variant      String
  event        String
  count        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([experimentId, variant, event])
  @@index([experimentId, updatedAt])
}

model TrafficMetric {
  bucketStart DateTime
  countryCode String
  deviceType  String
  pageViews   Int      @default(0)
  visits      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([bucketStart, countryCode, deviceType])
  @@index([bucketStart])
  @@index([countryCode, bucketStart])
  @@index([deviceType, bucketStart])
}

model TrafficSession {
  sessionHash     String    @id
  countryCode     String
  deviceType      String
  ipAddress       String?
  countryLookupAt DateTime?
  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([lastSeenAt])
}

model SiteSettings {
  id                    String   @id @default("default")
  siteName              String   @default("Dr Necrotix")
  siteDescription       String?
  faviconUrl            String?
  defaultTheme          String   @default("dark")
  allowDayMode          Boolean  @default(true)
  accentColor           String?
  locale                String   @default("en")
  timezone              String   @default("Europe/Sofia")
  socialLinks           Json?
  contactDetails        Json?
  homepageContent       Json?
  profileCardContent    Json?
  footerContent         Json?
  galleryContent        Json?
  seoDefaults           Json?
  assistantSettings     Json?
  integrationSettings   Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SiteModeSettings {
  id              String   @id @default("default")
  mode            SiteMode @default(NORMAL)
  template        String   @default("hero")
  startsAt        DateTime?
  endsAt          DateTime?
  bypassAdmins    Boolean  @default(true)
  passwordHash    String?
  title           String?
  message         String?  @db.Text
  countdownTarget DateTime?
  showSocials     Boolean  @default(true)
  showContact     Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  fileName  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  altText   String?
  caption   String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String   @id @default(cuid())
  source    String   @unique
  target    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Revision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  snapshot   Json
  note       String?
  createdAt  DateTime @default(now())
  createdBy  String?
  user       User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageId     String?
  page       Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model StoreProduct {
  id                    String                 @id @default(cuid())
  slug                  String                 @unique
  title                 String
  excerpt               String?
  description           String                 @db.Text
  category              String?
  tags                  String[]
  priceCents            Int
  compareAtPriceCents   Int?
  currency              String                 @default("EUR")
  coverImageUrl         String?
  lemonSqueezyVariantId String?
  status                StoreProductStatus     @default(DRAFT)
  featured              Boolean                @default(false)
  downloadLimit         Int                    @default(5)
  seoTitle              String?
  seoDescription        String?
  publishedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  files                 StoreProductFile[]
  orderItems            StoreOrderItem[]
  downloadGrants        StoreDownloadGrant[]
  checkoutSessions      StoreCheckoutSession[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([featured, status])
}

model StoreProductFile {
  id        String       @id @default(cuid())
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName  String
  storageKey String       @unique
  mimeType  String
  size      Int
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([productId, sortOrder])
}

model StoreOrder {
  id              String           @id @default(cuid())
  provider        String           @default("lemonsqueezy")
  providerOrderId String           @unique
  email           String
  customerName    String?
  currency        String           @default("EUR")
  subtotalCents   Int              @default(0)
  totalCents      Int              @default(0)
  status          StoreOrderStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           StoreOrderItem[]
  downloadGrants  StoreDownloadGrant[]

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model StoreOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title          String
  unitPriceCents Int
  quantity       Int           @default(1)
  createdAt      DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
}

model StoreDownloadGrant {
  id           String       @id @default(cuid())
  token        String       @unique
  orderId      String
  order        StoreOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads    Int          @default(0)
  maxDownloads Int          @default(5)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([orderId, productId])
  @@index([productId, createdAt])
}

model StoreCheckoutSession {
  id        String       @id @default(cuid())
  token     String       @unique
  productId String
  product   StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  expiresAt DateTime
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([productId, createdAt])
  @@index([expiresAt])
}
